def rollbackRequired = false

pipeline {

    agent {
        label 'default-agent'
    }

    options {
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    parameters {
        string(
            name: 'SOURCE_BUILD',
            defaultValue: '',
            description: 'Numer udanego builda CI, który ma zostać wdrożony'
        )

        booleanParam(
            name: 'RUN_DB_MIGRATION',
            defaultValue: false,
            description: 'Uruchomić migrację bazy danych przed deploymentem'
        )

        base64File 'MIGRATION_SQL'
    }

    environment {
        CI_JOB = 'spring-petclinic/main'

        PROD_APP_HOST = '192.168.56.30'
        PROD_DB_HOST  = '192.168.56.40'

        APP_CONTAINER = 'petclinic-prod-app'
        DB_CONTAINER  = 'petclinic-prod-db'

        DB_NAME = 'petclinic'
    }

    stages {

        // =========================================================
        // 1. VALIDATION
        // =========================================================
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.SOURCE_BUILD?.trim()) {
                        error('SOURCE_BUILD nie może być pusty.')
                    }

                    if (!(params.SOURCE_BUILD ==~ /^[0-9]+$/)) {
                        error('SOURCE_BUILD musi być numerem builda CI.')
                    }

                    echo "Selected CI build: ${params.SOURCE_BUILD}"
                    echo "Run DB migration: ${params.RUN_DB_MIGRATION}"
                }
            }
        }


        // =========================================================
        // 2. RETRIEVE EXACT CI ARTIFACT
        // =========================================================
        stage('Retrieve Artifact') {
            steps {
                copyArtifacts(
                    projectName: env.CI_JOB,
                    selector: specific("${params.SOURCE_BUILD}"),
                    filter: "petclinic-${params.SOURCE_BUILD}.tar",
                    fingerprintArtifacts: true
                )

                sh '''
                    test -f "petclinic-${SOURCE_BUILD}.tar"
                    ls -lh "petclinic-${SOURCE_BUILD}.tar"
                '''
            }
        }


        // =========================================================
        // 3. PRE-DEPLOYMENT CHECKS
        // =========================================================
        stage('Pre-deployment Checks') {
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-app-deploy-ssh',
                            keyFileVariable: 'APP_SSH_KEY',
                            usernameVariable: 'APP_SSH_USER'
                        ),
                        sshUserPrivateKey(
                            credentialsId: 'prod-db-deploy-ssh',
                            keyFileVariable: 'DB_SSH_KEY',
                            usernameVariable: 'DB_SSH_USER'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "Checking prod-app..."
                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "$APP_SSH_KEY" \
                              "$APP_SSH_USER@$PROD_APP_HOST" \
                              "docker info >/dev/null"

                            echo "Checking prod-db..."
                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "$DB_SSH_KEY" \
                              "$DB_SSH_USER@$PROD_DB_HOST" \
                              "docker exec $DB_CONTAINER pg_isready -U petclinic -d $DB_NAME"

                            echo "Checking disk space..."
                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "$APP_SSH_KEY" \
                              "$APP_SSH_USER@$PROD_APP_HOST" \
                              "df -h /"
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 4. DATABASE BACKUP
        // =========================================================
        stage('Backup Database') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'prod-db-deploy-ssh',
                        keyFileVariable: 'DB_SSH_KEY',
                        usernameVariable: 'DB_SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        BACKUP_FILE="petclinic-before-build-${SOURCE_BUILD}.dump"

                        echo "Creating database backup..."

                        ssh \
                          -o StrictHostKeyChecking=accept-new \
                          -i "$DB_SSH_KEY" \
                          "$DB_SSH_USER@$PROD_DB_HOST" \
                          "docker exec $DB_CONTAINER pg_dump -U petclinic -d $DB_NAME -Fc" \
                          > "$BACKUP_FILE"

                        test -s "$BACKUP_FILE"

                        ls -lh "$BACKUP_FILE"
                    '''
                }

                archiveArtifacts(
                    artifacts: "petclinic-before-build-${params.SOURCE_BUILD}.dump",
                    fingerprint: true
                )
            }
        }


        // =========================================================
        // 5. OPTIONAL DATABASE MIGRATION
        // =========================================================
        stage('Database Migration') {

            when {
                expression {
                    return params.RUN_DB_MIGRATION
                }
            }

            steps {
                withFileParameter('MIGRATION_SQL') {

                    sh '''
                        set -e

                        cp "$MIGRATION_SQL" "migration-${SOURCE_BUILD}.sql"

                        echo "Checking migration script..."

                        if grep -Eqi \
                          'DROP[[:space:]]+TABLE|DROP[[:space:]]+COLUMN|TRUNCATE' \
                          "migration-${SOURCE_BUILD}.sql"
                        then
                            echo "Destructive SQL detected."
                            exit 1
                        fi
                    '''

                    archiveArtifacts(
                        artifacts: "migration-${params.SOURCE_BUILD}.sql",
                        fingerprint: true
                    )

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-db-deploy-ssh',
                            keyFileVariable: 'DB_SSH_KEY',
                            usernameVariable: 'DB_SSH_USER'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "Executing database migration..."

                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "$DB_SSH_KEY" \
                              "$DB_SSH_USER@$PROD_DB_HOST" \
                              "docker exec -i $DB_CONTAINER \
                               psql \
                               -U petclinic \
                               -d $DB_NAME \
                               -v ON_ERROR_STOP=1 \
                               --single-transaction" \
                              < "migration-${SOURCE_BUILD}.sql"
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 6. REMEMBER CURRENT VERSION
        // =========================================================
        stage('Capture Current Version') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'prod-app-deploy-ssh',
                        keyFileVariable: 'APP_SSH_KEY',
                        usernameVariable: 'APP_SSH_USER'
                    )
                ]) {

                    sh '''
                        PREVIOUS_IMAGE=$(ssh \
                          -o StrictHostKeyChecking=accept-new \
                          -i "$APP_SSH_KEY" \
                          "$APP_SSH_USER@$PROD_APP_HOST" \
                          "docker inspect \
                           -f '{{.Config.Image}}' \
                           $APP_CONTAINER 2>/dev/null || true")

                        printf '%s' "$PREVIOUS_IMAGE" > previous-image.txt

                        echo "Previous production image:"
                        cat previous-image.txt
                        echo
                    '''
                }

                archiveArtifacts(
                    artifacts: 'previous-image.txt',
                    allowEmptyArchive: true
                )
            }
        }


        // =========================================================
        // 7. TRANSFER ARTIFACT
        // =========================================================
        stage('Transfer Artifact') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'prod-app-deploy-ssh',
                        keyFileVariable: 'APP_SSH_KEY',
                        usernameVariable: 'APP_SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        scp \
                          -o StrictHostKeyChecking=accept-new \
                          -i "$APP_SSH_KEY" \
                          "petclinic-${SOURCE_BUILD}.tar" \
                          "$APP_SSH_USER@$PROD_APP_HOST:/tmp/petclinic-${SOURCE_BUILD}.tar"

                        ssh \
                          -o StrictHostKeyChecking=accept-new \
                          -i "$APP_SSH_KEY" \
                          "$APP_SSH_USER@$PROD_APP_HOST" \
                          "docker load < /tmp/petclinic-${SOURCE_BUILD}.tar \
                           && rm -f /tmp/petclinic-${SOURCE_BUILD}.tar"
                    '''
                }
            }
        }


        // =========================================================
        // 8. DEPLOY APPLICATION
        // =========================================================
        stage('Deploy Application') {
            steps {
                script {

                    int deployStatus

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-app-deploy-ssh',
                            keyFileVariable: 'APP_SSH_KEY',
                            usernameVariable: 'APP_SSH_USER'
                        ),
                        usernamePassword(
                            credentialsId: 'prod-postgres',
                            usernameVariable: 'DB_USER',
                            passwordVariable: 'DB_PASS'
                        )
                    ]) {

                        deployStatus = sh(
                            returnStatus: true,
                            script: '''
                                set +x

                                cat > /tmp/petclinic-prod.env <<EOF
SPRING_PROFILES_ACTIVE=postgres
POSTGRES_URL=jdbc:postgresql://${PROD_DB_HOST}:5432/${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASS=${DB_PASS}
EOF

                                scp \
                                  -o StrictHostKeyChecking=accept-new \
                                  -i "$APP_SSH_KEY" \
                                  /tmp/petclinic-prod.env \
                                  "$APP_SSH_USER@$PROD_APP_HOST:/tmp/petclinic-prod.env"

                                rm -f /tmp/petclinic-prod.env

                                ssh \
                                  -o StrictHostKeyChecking=accept-new \
                                  -i "$APP_SSH_KEY" \
                                  "$APP_SSH_USER@$PROD_APP_HOST" \
                                  "docker rm -f $APP_CONTAINER >/dev/null 2>&1 || true

                                   docker run -d \
                                     --name $APP_CONTAINER \
                                     --restart unless-stopped \
                                     -p 8080:8080 \
                                     --env-file /tmp/petclinic-prod.env \
                                     petclinic:${SOURCE_BUILD}

                                   rm -f /tmp/petclinic-prod.env"
                            '''
                        )
                    }

                    if (deployStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Application deployment failed.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 9. CONTAINER STATUS
        // =========================================================
        stage('Container Status Check') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            steps {
                script {

                    int containerStatus

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-app-deploy-ssh',
                            keyFileVariable: 'APP_SSH_KEY',
                            usernameVariable: 'APP_SSH_USER'
                        )
                    ]) {

                        containerStatus = sh(
                            returnStatus: true,
                            script: '''
                                STATUS=$(ssh \
                                  -o StrictHostKeyChecking=accept-new \
                                  -i "$APP_SSH_KEY" \
                                  "$APP_SSH_USER@$PROD_APP_HOST" \
                                  "docker inspect \
                                   -f '{{.State.Running}}' \
                                   $APP_CONTAINER 2>/dev/null")

                                echo "Container running: $STATUS"

                                test "$STATUS" = "true"
                            '''
                        )
                    }

                    if (containerStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Production container is not running.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 10. HEALTH CHECK
        // =========================================================
        stage('Health Check') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            steps {
                script {

                    int healthStatus = sh(
                        returnStatus: true,
                        script: '''
                            echo "Waiting for application..."

                            for i in $(seq 1 12)
                            do
                                if curl \
                                  -fsS \
                                  --max-time 5 \
                                  "http://${PROD_APP_HOST}:8080/" \
                                  >/dev/null
                                then
                                    echo "Health check passed."
                                    exit 0
                                fi

                                echo "Attempt $i/12 failed."
                                sleep 5
                            done

                            exit 1
                        '''
                    )

                    if (healthStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Production health check failed.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 11. HTTP SMOKE TEST
        // =========================================================
        stage('Smoke Test') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            steps {
                script {

                    int smokeStatus = sh(
                        returnStatus: true,
                        script: '''
                            set -e

                            curl \
                              -fsS \
                              --max-time 10 \
                              "http://${PROD_APP_HOST}:8080/owners/find" \
                              >/dev/null

                            curl \
                              -fsS \
                              --max-time 10 \
                              "http://${PROD_APP_HOST}:8080/vets.html" \
                              >/dev/null
                        '''
                    )

                    if (smokeStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Production smoke test failed.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 12. INITIAL LOG ANALYSIS
        // =========================================================
        stage('Initial Log Analysis') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            steps {
                script {

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-app-deploy-ssh',
                            keyFileVariable: 'APP_SSH_KEY',
                            usernameVariable: 'APP_SSH_USER'
                        )
                    ]) {

                        sh '''
                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "$APP_SSH_KEY" \
                              "$APP_SSH_USER@$PROD_APP_HOST" \
                              "docker logs --tail 200 $APP_CONTAINER 2>&1" \
                              > prod-initial.log
                        '''
                    }

                    archiveArtifacts(
                        artifacts: 'prod-initial.log',
                        allowEmptyArchive: true
                    )

                    int criticalLogs = sh(
                        returnStatus: true,
                        script: '''
                            grep -Eqi 'ERROR|FATAL' prod-initial.log
                        '''
                    )

                    /*
                     * grep:
                     * 0 = pattern found
                     * 1 = pattern not found
                     */

                    if (criticalLogs == 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Critical errors detected in application logs.')
                        }

                    } else {

                        int warningLogs = sh(
                            returnStatus: true,
                            script: '''
                                grep -Eqi 'WARN' prod-initial.log
                            '''
                        )

                        if (warningLogs == 0) {
                            unstable('Warnings detected in initial production logs.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 13. STABILIZATION / SECOND CHECK
        // =========================================================
        stage('Post-deployment Verification') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            steps {
                script {

                    int verificationStatus = sh(
                        returnStatus: true,
                        script: '''
                            echo "Waiting for stabilization..."
                            sleep 20

                            curl \
                              -fsS \
                              --max-time 10 \
                              "http://${PROD_APP_HOST}:8080/" \
                              >/dev/null
                        '''
                    )

                    if (verificationStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Post-deployment verification failed.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 14. SELENIUM E2E
        // =========================================================
        stage('Selenium E2E Test') {

            when {
                expression {
                    return !rollbackRequired
                }
            }

            agent {
                label 'selenium-agent'
            }

            steps {

                checkout scm

                script {

                    int seleniumStatus = sh(
                        returnStatus: true,
                        script: '''
                            python tests/selenium/prod_smoke.py
                        '''
                    )

                    /*
                     * prod_smoke.py zapisuje te pliki tylko w razie
                     * niepowodzenia testu.
                     */
                    archiveArtifacts(
                        artifacts: 'selenium-failure.png,selenium-page.html',
                        allowEmptyArchive: true
                    )

                    if (seleniumStatus != 0) {

                        rollbackRequired = true

                        catchError(
                            buildResult: 'SUCCESS',
                            stageResult: 'FAILURE'
                        ) {
                            error('Selenium E2E test failed.')
                        }
                    }
                }
            }
        }


        // =========================================================
        // 15. AUTOMATIC APPLICATION ROLLBACK
        // =========================================================
        stage('Automatic Application Rollback') {

            when {
                expression {
                    return rollbackRequired
                }
            }

            steps {
                script {

                    String previousImage = readFile(
                        'previous-image.txt'
                    ).trim()

                    if (!previousImage) {
                        error(
                            'Rollback required, but no previous production image exists.'
                        )
                    }

                    echo "Rolling back application to: ${previousImage}"

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'prod-app-deploy-ssh',
                            keyFileVariable: 'APP_SSH_KEY',
                            usernameVariable: 'APP_SSH_USER'
                        ),
                        usernamePassword(
                            credentialsId: 'prod-postgres',
                            usernameVariable: 'DB_USER',
                            passwordVariable: 'DB_PASS'
                        )
                    ]) {

                        sh """
                            set +x

                            cat > /tmp/petclinic-prod.env <<EOF
SPRING_PROFILES_ACTIVE=postgres
POSTGRES_URL=jdbc:postgresql://${env.PROD_DB_HOST}:5432/${env.DB_NAME}
POSTGRES_USER=\${DB_USER}
POSTGRES_PASS=\${DB_PASS}
EOF

                            scp \
                              -o StrictHostKeyChecking=accept-new \
                              -i "\$APP_SSH_KEY" \
                              /tmp/petclinic-prod.env \
                              "\$APP_SSH_USER@${env.PROD_APP_HOST}:/tmp/petclinic-prod.env"

                            rm -f /tmp/petclinic-prod.env

                            ssh \
                              -o StrictHostKeyChecking=accept-new \
                              -i "\$APP_SSH_KEY" \
                              "\$APP_SSH_USER@${env.PROD_APP_HOST}" \
                              "docker rm -f ${env.APP_CONTAINER} >/dev/null 2>&1 || true

                               docker run -d \
                                 --name ${env.APP_CONTAINER} \
                                 --restart unless-stopped \
                                 -p 8080:8080 \
                                 --env-file /tmp/petclinic-prod.env \
                                 ${previousImage}

                               rm -f /tmp/petclinic-prod.env"
                        '''
                    }

                    sh '''
                        echo "Checking rolled-back application..."

                        for i in $(seq 1 12)
                        do
                            if curl \
                              -fsS \
                              --max-time 5 \
                              "http://${PROD_APP_HOST}:8080/" \
                              >/dev/null
                            then
                                echo "Rollback health check passed."
                                exit 0
                            fi

                            echo "Rollback health attempt $i/12 failed."
                            sleep 5
                        done

                        echo "Rolled-back application is not healthy."
                        exit 1
                    """

                    echo 'Application rollback completed successfully.'
                    echo 'Database was NOT restored.'
                }
            }
        }
    }


    // =============================================================
    // FINAL RESULT
    // =============================================================
    post {

        always {
            script {
                /*
                 * Jeżeli deployment wymagał rollbacku,
                 * sam rollback może zakończyć się sukcesem,
                 * ale deployment jako całość nadal był nieudany.
                 */
                if (rollbackRequired) {
                    currentBuild.result = 'FAILURE'
                }
            }
        }

        success {
            echo 'Production deployment successful.'
        }

        unstable {
            echo 'Production deployment completed with warnings.'
        }

        failure {
            echo 'Production deployment failed.'
        }

        cleanup {
            deleteDir()
        }
    }
}
